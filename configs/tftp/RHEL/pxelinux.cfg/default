DEFAULT menu.c32
PROMPT 0
TIMEOUT 30
ONTIMEOUT local

MENU TITLE RHEL Network Installation

LABEL local
      MENU LABEL Boot from Local-Disk
      MENU DEFAULT
      LOCALBOOT 0

LABEL rhel8-auto
      MENU LABEL Install RHEL 8 (Automated Kickstart)
      KERNEL BIOS/rhel8/vmlinuz
      INITRD BIOS/rhel8/initrd.img
      APPEND inst.ks=http://192.168.10.1/BIOS/ks.cfg inst.repo=http://192.168.10.1/BIOS/rhel8/ ip=dhcp
